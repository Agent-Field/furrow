FROM rust:1.97.1-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY furrow-core ./furrow-core
COPY furrow-cli ./furrow-cli
COPY furrow-daemon ./furrow-daemon
RUN cargo build --release --locked -p furrow-cli --bin furrow -j 2

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates coreutils findutils git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/furrow /usr/local/bin/furrow
WORKDIR /machine
CMD ["sleep", "infinity"]
